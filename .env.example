# Shopify Storefront API configuration (server-side only)
# The Storefront API token needs unauthenticated_read_product_inventory for exact quantity limits.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token
SHOPIFY_STOREFRONT_API_VERSION=YYYY-MM
